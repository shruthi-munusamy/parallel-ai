# Copy to .env and fill in. .env is gitignored.
#
# Both keys are optional. Without them the pipeline still runs end to end:
#   no TAVILY_API_KEY    -> SearchService serves a built-in mock corpus
#   no ANTHROPIC_API_KEY -> QueryDecomposer uses rule-based expansion

# Web search (https://tavily.com)
TAVILY_API_KEY=

# Query decomposition (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Models ───────────────────────────────────────────────────────────────────
# Local checkpoint from backend/training/train_stance.py; falls back to the
# zero-shot NLI model below when the path does not exist.
STANCE_CHECKPOINT=./checkpoints/stance_deberta
STANCE_FALLBACK_MODEL=cross-encoder/nli-deberta-v3-base
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
DECOMPOSER_MODEL=claude-haiku-4-5-20251001

# ── Inference ────────────────────────────────────────────────────────────────
# Monte Carlo dropout passes. Latency is linear in this value. Measured on CPU
# over 30 passages: T=10 -> 7.2s, T=5 -> 3.7s, T=1 -> 0.6s. Set to 1 to disable
# uncertainty estimation and run a single deterministic pass.
MC_SAMPLES=5
STANCE_BATCH_SIZE=16
UNRELATED_THRESHOLD=0.40

# ── Retrieval ────────────────────────────────────────────────────────────────
FETCH_CONCURRENCY=10
FETCH_TIMEOUT_S=8.0
PASSAGES_PER_SOURCE=3

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL_S=3600
CACHE_MAX_ENTRIES=512

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
